# Что агент Zoo Code НЕ читает и не видит в контексте (синтаксис как у .gitignore).
# Цель — экономия токенов. Скрипты (PowerShell) по-прежнему могут копировать/сжимать эти файлы.

# Временное и мусор
tmp/
tmp_*
debug.html
*.log

# Картинки: агент не открывает их сам (каждая = картинка в запросе модели).
# Нужно показать агенту арт — перетащи картинку прямо в чат
# или временно закомментируй строку ниже (#).
*.png
*.jpg
*.jpeg
*.webp
*.gif

# Служебное
.vscode/
node_modules/
